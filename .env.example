# Copy this file to .env and fill in real values. NEVER commit a real .env.
# All values are read once at startup; DATABASE_URL and JWT_SECRET are required.

# PostgreSQL connection string, e.g. postgres://user:pass@host:5432/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vili?sslmode=disable

# Secret used to sign JWTs (HS256). Must be non-empty. Generate a strong random value.
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port the server listens on.
PORT=8080

# JWT lifetime in minutes.
JWT_EXPIRY_MINUTES=60

# --- Phase 5: hardening, observability, rate limiting -------------------------

# Max bytes for any JSON request body (oversize -> 413).
MAX_BODY_BYTES=1048576

# Send defensive headers (X-Content-Type-Options, X-Frame-Options,
# Referrer-Policy, Content-Security-Policy) on every response.
SECURITY_HEADERS_ENABLED=true

# Comma-separated cross-origin allowlist. Empty = deny-by-default (the CLI and
# the local-file index.html demo don't need a CORS grant).
CORS_ALLOWED_ORIGINS=

# Token-bucket rate limiting. Per-IP on /v1/auth/*, per-user on message POST.
# 429 + Retry-After when exceeded. Set RATE_LIMIT_ENABLED=false to disable.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_RPS=5
RATE_LIMIT_AUTH_BURST=10
RATE_LIMIT_MESSAGES_RPS=10
RATE_LIMIT_MESSAGES_BURST=20

# Cap on concurrent live WebSocket connections per user.
WS_MAX_CONNS_PER_USER=5

# Per-request access log (method, route, status, duration; never tokens/bodies).
REQUEST_LOG_ENABLED=true

# Prometheus text metrics at /metrics.
METRICS_ENABLED=true

# net/http/pprof under /debug/pprof. OFF by default; enable only in a trusted
# environment — it exposes goroutine stacks, heap, and traces.
PPROF_ENABLED=false
