# Copy this file to .env and fill in real values. NEVER commit a real .env.
# All values are read once at startup; DATABASE_URL and JWT_SECRET are required.

# PostgreSQL connection string, e.g. postgres://user:pass@host:5432/dbname?sslmode=disable
DATABASE_URL=postgres://postgres:postgres@localhost:5432/vili?sslmode=disable

# Secret used to sign JWTs (HS256). Must be non-empty. Generate a strong random value.
JWT_SECRET=change-me-to-a-long-random-string

# HTTP port the server listens on.
PORT=8080

# JWT lifetime in minutes.
JWT_EXPIRY_MINUTES=60
